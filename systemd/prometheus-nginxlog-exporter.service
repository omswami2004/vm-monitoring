[Unit]
Description=nginx access-log exporter (per-vhost status/latency)
Documentation=https://github.com/omswami2004/vm-monitoring
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nginxlog_exporter
Group=nginxlog_exporter
ExecStart=/usr/local/bin/prometheus-nginxlog-exporter -config-file /etc/prometheus-nginxlog-exporter/config.hcl

Restart=on-failure
RestartSec=5
MemoryMax=128M
# adm can read /var/log/nginx/*.log
SupplementaryGroups=adm
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6


[Install]
WantedBy=multi-user.target
