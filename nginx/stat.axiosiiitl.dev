# Alert intake for Grafana Cloud (alerts about other machines) → wa-relay → WhatsApp.
# Only POST /cloud-alert is exposed; wa-relay checks the bearer token. Everything else is 404.
server {
    listen 80;
    listen [::]:80;
    server_name stat.axiosiiitl.dev;
    server_tokens off;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://stat.axiosiiitl.dev$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name stat.axiosiiitl.dev;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/stat.axiosiiitl.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stat.axiosiiitl.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 1m;

    location = /cloud-alert {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:9097/cloud-alert;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / { return 404; }
}
