# Copy to /etc/wa-relay/env  (owner wa-relay, mode 600):
#   sudo install -o wa-relay -g wa-relay -m 600 env.sample /etc/wa-relay/env && sudoedit /etc/wa-relay/env
WA_SERVER_URL=https://your-whatsapp-server.example.com
WA_API_KEY=change-me
# Comma-separated: 10-digit Indian numbers, full numbers with country code, or chat IDs (…@g.us for a group)
WA_TO=9876543210
GRAFANA_URL=https://stat.axiosiiitl.dev
LISTEN_ADDR=127.0.0.1:9097
# Bearer token Grafana Cloud's webhook contact point sends to https://stat.axiosiiitl.dev/cloud-alert
# Generate: openssl rand -hex 32
CLOUD_TOKEN=
