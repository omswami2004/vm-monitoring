{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "uid": "ampere-services",
 "title": "Services by host",
 "tags": [
  "ampere-m1",
  "trading-vm",
  "overview"
 ],
 "templating": {
  "list": [
   {
    "name": "Filters",
    "type": "adhoc",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "filters": [
     {
      "key": "host",
      "operator": "=",
      "value": "ampere-m1",
      "condition": ""
     }
    ]
   }
  ]
 },
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": false,
 "panels": [
  {
   "type": "row",
   "title": "Status",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "systemd services",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "refId": "A",
     "expr": "max by (name) (node_systemd_unit_state{state=\"active\",name=~\"(sattle|txntrace|jarvis-bridge|screen-streamer|private-cdn|nginx|prometheus|alertmanager|alloy|node_exporter|process-exporter|blackbox_exporter|nginx-prometheus-exporter|prometheus-nginxlog-exporter|wa-relay)\\\\.service\"})",
     "legendFormat": "{{name}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "orientation": "horizontal",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
   "title": "User services (ubuntu)",
