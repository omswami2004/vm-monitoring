     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "orientation": "horizontal",
    "justifyMode": "auto"
   }
  },
  {
   "type": "stat",
